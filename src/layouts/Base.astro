---
import { getCollection } from 'astro:content';
import '@fontsource-variable/archivo/wdth.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Exploring Earth's processes in Brazil" } = Astro.props;
const base = import.meta.env.BASE_URL;
const processes = (await getCollection('processes')).sort((a, b) => a.data.order - b.data.order);
const current = Astro.url.pathname;
const isActive = (href: string) => current === href;
// The date of the build that published this page
const updated = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Earth Processes in Brazil</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {/* Link preview (for example when the site link is posted on Canvas) */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Earth Processes in Brazil`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}images/places/brasilia-torre.jpg`, Astro.site).href} />
    <meta property="og:image:alt" content="The Eixo Monumental seen from the TV Tower: the TV Tower fountain in front, then the road loops and the Esplanada leading to the National Congress" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={base}>Earth Processes in <span>Brazil</span></a>
      <nav aria-label="Main">
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links">Menu</button>
        <div class="nav-links" id="nav-links">
        <a href={base} aria-current={isActive(base) ? 'page' : undefined}>Home</a>
        <a href={`${base}about/`} aria-current={isActive(`${base}about/`) ? 'page' : undefined}>About</a>
        <details class="dropdown">
          <summary>Earth Processes</summary>
          <ul>
            {processes.map((p) => (
              <li>
                <a href={`${base}processes/${p.id}/`} aria-current={isActive(`${base}processes/${p.id}/`) ? 'page' : undefined}>
                  <span class="dropdown-week">Week {p.data.week}</span>
                  <span class="dropdown-title">
                    {p.data.title}
                    {p.data.draft && <span class="dropdown-status">Coming soon</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </details>
        <a href={`${base}references/`} aria-current={isActive(`${base}references/`) ? 'page' : undefined}>References</a>
        </div>
      </nav>
    </header>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Vitor Figueredo · PS 120 Earth Science · Ensign College · Updated {updated}</p>
    </footer>
    <script>
      // Small screens: the main links sit behind a Menu button
      const nav = document.querySelector<HTMLElement>('.site-header nav');
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const setNavOpen = (open: boolean) => {
        nav?.toggleAttribute('data-open', open);
        toggle?.setAttribute('aria-expanded', String(open));
      };
      toggle?.addEventListener('click', () => setNavOpen(toggle.getAttribute('aria-expanded') !== 'true'));

      // Close the Earth Processes menu (and the mobile menu) on Escape or on a click outside it
      const menu = document.querySelector<HTMLDetailsElement>('.dropdown');
      document.addEventListener('click', (event) => {
        if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
        if (nav?.hasAttribute('data-open') && !nav.contains(event.target as Node)) setNavOpen(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        if (menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        } else if (nav?.hasAttribute('data-open')) {
          setNavOpen(false);
          toggle?.focus();
        }
      });
    </script>
  </body>
</html>
